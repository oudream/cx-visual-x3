<Window x:Class="CxVisual.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scene="clr-namespace:CxVisual.Mechanism.Presentation.Wpf;assembly=CxVisual.Mechanism.Presentation.Wpf"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        Title="CxVisual Studio" Width="1560" Height="940"
        MinWidth="1024" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource StudioBackgroundBrush}" Foreground="{DynamicResource StudioTextBrush}" FontFamily="Segoe UI">
    <DockPanel LastChildFill="True">
        <!-- 应用与工程身份：动态取当前MEM项目，不再写死Demo_Project，也不展示假的搜索入口。 -->
        <Border DockPanel.Dock="Top" Padding="14,7"
                Background="{DynamicResource StudioHeaderBrush}"
                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="统一工程工作区" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource StudioAccentBrush}"/>
                    <Button Content="切换浅色 / 深色" Click="OnStudioThemeClick" Padding="11,5"
                            ToolTip="只修改Studio显示主题，不修改MEM工程与Undo历史"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource StudioAccentBrush}" CornerRadius="5"
                            Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="CX" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="CxVisual Studio" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  /  " Foreground="{DynamicResource StudioAccentBrush}"
                               VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="StudioHeaderProjectName" Text="{Binding StudioProjectTitle}"
                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="320" ToolTip="{Binding StudioProjectTitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource StudioPanelBrush}" Padding="5,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StudioBorderBrush}">
            <StackPanel x:Name="StudioStaticMenus" Orientation="Horizontal">
                <Button Content="文件" Tag="文件" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="编辑" Tag="编辑" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="视图" Tag="视图" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="工程" Tag="工程" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="调试" Tag="调试" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="运行" Tag="运行" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="发布" Tag="发布" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="工具" Tag="工具" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Button Content="帮助" Tag="帮助" Click="OnStudioMenuClick" Style="{StaticResource StudioMenuTabStyle}"/>
                <Separator Width="1" Margin="8,4" Background="{DynamicResource StudioBorderBrush}"/>
                <StackPanel x:Name="StudioDynamicMenus" Orientation="Horizontal"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource StudioPanelBrush}" Padding="6,3" BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StudioRibbonActions" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NewCommand}" Content="新建工程"/>
                <Button Command="{Binding AddCommand}" Content="添加矩形"/>
                <Button Command="{Binding MoveCommand}" Content="右移20"/>
                <Button Command="{Binding UndoCommand}" Content="撤销"/>
                <Button Command="{Binding RedoCommand}" Content="重做"/>
                <Button Command="{Binding SaveCommand}" Content="保存工程"/>
                <Button Command="{Binding LoadCommand}" Content="打开工程"/>
                <Button Command="{Binding AddPageCommand}" Content="添加页面"/>
                <Button Command="{Binding AddContentCommand}" Content="共享内容"/>
                <Button Command="{Binding AddSymbolCommand}" Content="新建组件"/>
                <Button Command="{Binding DeleteCommand}" Content="删除选中"/>
                <Button Command="{Binding ImportCommand}" Content="导入资源包"/>
                <Button Command="{Binding ExportCommand}" Content="导出所选资源"/>
                <Button Command="{Binding GroupCommand}" Content="所选图元成组"/>
                <Button Command="{Binding UngroupCommand}" Content="解散选中或父分组"/>
                <Button Command="{Binding AddAssetCommand}" Content="添加静态资源"/>
                <ComboBox x:Name="ConfigDemoKind" Width="150" SelectedIndex="0" Margin="10,0,4,0"
                          VerticalContentAlignment="Center" ToolTip="选择一种专业配置案例，均使用统一L1配置服务">
                    <ComboBoxItem Content="Studio配置"/>
                    <ComboBoxItem Content="Automation设备"/>
                    <ComboBoxItem Content="Vision检测"/>
                    <ComboBoxItem Content="CT3D重建"/>
                    <ComboBoxItem Content="复杂配置与集合"/>
                </ComboBox>
                <Button Click="OnConfigDemo" Content="配置编辑 V2.4"/>
                <Button Click="OnEmbeddedConfigDemo" Content="嵌入式编辑"/>
                <Button Click="OnAtomicLayerDemo" Content="原子层配置"/>
                <Button Click="OnMultiModelConfigDemo" Content="多模型原子组"/>
                <Button Click="OnIndependentLayerDemo" Content="独立层配置"/>
                <Button Click="OnPublishConfigDemo" Content="发布示例配置 (L4)"/>
                <Button Click="OnRollbackConfigDemo" Content="回滚发布"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StudioSurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StudioBorderBrush}" Padding="10,5">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StudioTextBrush}" />
        </Border>
        <dock:DockingManager x:Name="StudioDock" ActiveContentChanged="OnStudioActiveContentChanged">
            <dock:LayoutRoot><dock:LayoutPanel Orientation="Vertical">
                <dock:LayoutPanel Orientation="Horizontal">
                    <dock:LayoutAnchorablePane DockWidth="250">
                        <dock:LayoutAnchorable ContentId="tool.resources" Title="工程资源管理器" CanClose="True" CanHide="True" CanFloat="True" CanAutoHide="True">
                            <DockPanel Background="{DynamicResource StudioPanelBrush}" Margin="5">
                                <TextBlock DockPanel.Dock="Bottom" Text="仅工程与资源定义；Group/Element在独立图形结构面板管理。"
                                           TextWrapping="Wrap" FontSize="11" Margin="6,8,6,4"/>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBox x:Name="StudioResourceSearch"
                                             ToolTip="筛选页面、Content和Symbol；不修改MEM工程"
                                             TextChanged="OnStudioResourceSearchChanged" Margin="4" />
                                    <Button x:Name="StudioResourceBackButton" Content="返回上次位置"
                                            Command="{Binding BackCommand}" HorizontalAlignment="Left"
                                            ToolTip="从共享定义返回原资源及选中的实例；不会修改工程"
                                            Padding="8,3" Margin="4,0,4,6"/>
                                </StackPanel>
                                <TreeView x:Name="StudioResourceTree" BorderThickness="0"
                                          SelectedItemChanged="OnStudioResourceTreeSelected"
                                          MouseDoubleClick="OnStudioResourceTreeDoubleClick"/>
                            </DockPanel>
                        </dock:LayoutAnchorable>
                        <dock:LayoutAnchorable ContentId="tool.toolbox" Title="工具箱" CanClose="True" CanHide="True" CanFloat="True" CanAutoHide="True">
                            <ScrollViewer Background="{DynamicResource StudioPanelBrush}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="基础图元" FontWeight="SemiBold" FontSize="13" Margin="2,4,0,8"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="直线" Tag="Line" Click="OnInsertShape" ToolTip="创建Line"/>
                                        <Button Content="矩形" Tag="Rect" Click="OnInsertShape" ToolTip="创建Rectangle"/>
                                        <Button Content="圆" Tag="Circle" Click="OnInsertShape"/>
                                        <Button Content="椭圆" Tag="Ellipse" Click="OnInsertShape"/>
                                        <Button Content="折线" Tag="Polyline" Click="OnInsertShape"/>
                                        <Button Content="多边形" Tag="Polygon" Click="OnInsertShape"/>
                                        <Button Content="圆弧" Tag="Arc" Click="OnInsertShape"/>
                                        <Button Content="贝塞尔" Tag="Bezier" Click="OnInsertShape"/>
                                        <Button Content="路径" Tag="Path" Click="OnInsertShape"/>
                                        <Button Content="文本" Tag="Text" Click="OnInsertShape"/>
                                    </UniformGrid>
                                    <Separator Margin="0,12,0,10"/>
                                    <TextBlock Text="Widget 控件" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,8"/>
                                    <UniformGrid Columns="2">
                                        <Button Content="按钮" Tag="WidgetButton" Click="OnInsertShape"/>
                                        <Button Content="文本框" Tag="core.widget.textbox" Click="OnInsertShape"/>
                                        <Button Content="复选框" Tag="core.widget.checkbox" Click="OnInsertShape"/>
                                        <Button Content="滑块" Tag="core.widget.slider" Click="OnInsertShape"/>
                                        <Button Content="进度条" Tag="core.widget.progressbar" Click="OnInsertShape"/>
                                        <Button Content="下拉框" Tag="core.widget.combobox" Click="OnInsertShape"/>
                                    </UniformGrid>
                                    <Separator Margin="0,12,0,10"/>
                                    <TextBlock Text="专业能力" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,5"/>
                                    <TextBlock Text="流程节点与专业工具随当前资源编辑器切换，使用统一Owner命令。"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource StudioTextBrush}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                    <dock:LayoutDocumentPane>
                        <dock:LayoutDocument ContentId="doc.home" Title="主页" CanClose="True" CanFloat="True">

                            <!-- DOCS/界面设计 01：首页作为真正MEM工程总览，不是模拟项目/假模板。 -->
                            <ScrollViewer Background="{DynamicResource StudioBackgroundBrush}" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StudioHomeWorkArea" Margin="12">
                                    <!-- 上方欢迎横幅：浅蓝工业工作台视觉，数据来自当前MEM工程。 -->
                                    <Border CornerRadius="10" BorderBrush="{DynamicResource StudioBorderBrush}"
                                            BorderThickness="1" Height="162" Margin="0,0,0,11"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#D7EDFF" Offset="0"/>
                                                <GradientStop Color="#B5D8FC" Offset="0.53"/>
                                                <GradientStop Color="#EAF5FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="43*"/>
                                                <ColumnDefinition Width="57*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="19,12,8,11" VerticalAlignment="Center">
                                                <TextBlock Text="欢迎使用 CxVisual" FontWeight="Bold" FontSize="23"
                                                           Foreground="#103B7C" Margin="0,0,0,4"/>
                                                <TextBlock Text="统一工业工程 · 让工程设计与执行更高效"
                                                           FontSize="12" Foreground="#315F98" TextWrapping="Wrap"/>
                                                <TextBlock Text="当前工程" Margin="0,12,0,3"
                                                           FontSize="11" Foreground="#315F98"/>
                                                <TextBlock Text="{Binding StudioProjectTitle}" FontSize="15"
                                                           FontWeight="SemiBold" Foreground="#103B7C"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                            </StackPanel>
                                            <UniformGrid Grid.Column="1" Columns="2" Rows="2"
                                                         Margin="2,12,13,12">
                                                <Border Background="#F3FAFF" CornerRadius="8"
                                                        Margin="4" Padding="9,7" BorderBrush="#C8DFFA" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="资源定义" FontSize="11" Foreground="#345884"/>
                                                        <TextBlock Text="{Binding Resources.Count}" FontSize="19"
                                                                   FontWeight="Bold" Foreground="#1264D8"/>
                                                        <TextBlock Text="来自当前MEM工程" FontSize="10" Foreground="#6785A9"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F3FAFF" CornerRadius="8"
                                                        Margin="4" Padding="9,7" BorderBrush="#C8DFFA" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="页面数量" FontSize="11" Foreground="#345884"/>
                                                        <TextBlock Text="{Binding Pages.Count}" FontSize="19"
                                                                   FontWeight="Bold" Foreground="#1264D8"/>
                                                        <TextBlock Text="HMI工程页面" FontSize="10" Foreground="#6785A9"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F3FAFF" CornerRadius="8"
                                                        Margin="4" Padding="9,7" BorderBrush="#C8DFFA" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="工程Revision" FontSize="11" Foreground="#345884"/>
                                                        <TextBlock Text="{Binding Revision}" FontSize="19"
                                                                   FontWeight="Bold" Foreground="#1264D8"/>
                                                        <TextBlock Text="MEM版本序号" FontSize="10" Foreground="#6785A9"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F3FAFF" CornerRadius="8"
                                                        Margin="4" Padding="9,7" BorderBrush="#C8DFFA" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="修改状态" FontSize="11" Foreground="#345884"/>
                                                        <TextBlock Text="{Binding IsDirty, StringFormat=Dirty: {0}}"
                                                                   FontSize="14" FontWeight="Bold" Foreground="#1264D8"/>
                                                        <TextBlock Text="提交后可保存工程" FontSize="10" Foreground="#6785A9"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                    <!-- 新建/打开/模板等入口与原设计图同位置；只暴露实际可运行能力。 -->
                                    <WrapPanel x:Name="StudioHomeWorkflows" Margin="0,0,0,7">
                                        <Border Width="215" Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12" Margin="0,0,9,9">
                                            <StackPanel>
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="新建工程" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                                <TextBlock Text="创建统一MEM工程" FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button Content="新建工程  →" Command="{Binding NewCommand}"
                                                        Style="{StaticResource StudioPrimaryButtonStyle}"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="215" Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12" Margin="0,0,9,9">
                                            <StackPanel>
                                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="打开工程" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                                <TextBlock Text="加载已有的工程定义" FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button Content="选择工程  →" Command="{Binding LoadCommand}"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="215" Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12" Margin="0,0,9,9">
                                            <StackPanel>
                                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="HMI / 图元" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                                <TextBlock Text="编辑页面与可复用Symbol" FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button x:Name="StudioHomeHmiOpen" Content="进入 HMI  →" Tag="doc.visual"
                                                        Click="OnStudioOpenDocumentClick" HorizontalAlignment="Left"
                                                        Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="215" Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12" Margin="0,0,9,9">
                                            <StackPanel>
                                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="流程编排" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                                <TextBlock Text="编辑真实MOL流程与子流程" FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button x:Name="StudioHomeFlowOpen" Content="进入流程  →" Tag="doc.flow"
                                                        Click="OnStudioOpenDocumentClick" HorizontalAlignment="Left"
                                                        Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="专业工作区" FontWeight="SemiBold" FontSize="16" Margin="1,4,0,5"/>
                                        <TextBlock Grid.Column="1" Text="复用已有公共Editor / Provider"
                                                   FontSize="11" Foreground="{DynamicResource StudioMutedTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Border Width="235" CornerRadius="9" Padding="14" Margin="0,0,9,9"
                                                Background="{DynamicResource StudioCardTintBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="资源配置 / MHS" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                                <TextBlock Text="按Schema编辑、保存与授权生效" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button x:Name="StudioHomeConfigOpen" Content="打开配置中心"
                                                        Tag="doc.config" Click="OnStudioOpenDocumentClick"
                                                        HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="235" CornerRadius="9" Padding="14" Margin="0,0,9,9"
                                                Background="{DynamicResource StudioCardTintBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="工程资源" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                                <TextBlock Text="资源树、Page、Content、Symbol" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <TextBlock Text="{Binding Resources.Count, StringFormat=资源项：{0}}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="235" CornerRadius="9" Padding="14" Margin="0,0,9,9"
                                                Background="{DynamicResource StudioCardTintBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                           Foreground="{DynamicResource StudioAccentBrush}"/>
                                                <TextBlock Text="构建与运行" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,3"/>
                                                <TextBlock Text="MOC验证、MRK仿真与Trace" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                                <Button Content="前往流程构建" Tag="doc.flow" Click="OnStudioOpenDocumentClick"
                                                        HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="9" Padding="13"
                                                Margin="0,0,9,0"
                                                Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="当前工程 · 资源列表" FontSize="14" FontWeight="SemiBold"
                                                           Margin="0,0,0,9"/>
                                                <ItemsControl ItemsSource="{Binding Resources}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource StudioBorderBrush}"
                                                                    BorderThickness="0,0,0,1" Padding="4,5">
                                                                <DockPanel>
                                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13" Foreground="{DynamicResource StudioAccentBrush}"
                                                                               Margin="0,0,8,0"/>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="9" Padding="13"
                                                Background="{DynamicResource StudioPanelBrush}"
                                                BorderBrush="{DynamicResource StudioBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="工程动态与诊断" FontSize="14" FontWeight="SemiBold"
                                                           Margin="0,0,0,9"/>
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
                                                <Separator Margin="0,12,0,10"/>
                                                <TextBlock Text="资源与图元结构在左侧工具窗管理，属性和运行信息随活动工作区更新。"
                                                           TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource StudioMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </dock:LayoutDocument>

                <dock:LayoutDocument ContentId="doc.visual" Title="HMI图元与Symbol [设计]" CanClose="True" CanFloat="True">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,2,4,6">
                            <WrapPanel>
                                <Button Content="直线" Tag="Line" Click="OnInsertShape"/>
                                <Button Content="矩形Shape" Tag="Rect" Click="OnInsertShape"/>
                                <Button Content="圆形" Tag="Circle" Click="OnInsertShape"/>
                                <Button Content="椭圆" Tag="Ellipse" Click="OnInsertShape"/>
                                <Button Content="折线" Tag="Polyline" Click="OnInsertShape"/>
                                <Button Content="多边形" Tag="Polygon" Click="OnInsertShape"/>
                                <Button Content="圆弧" Tag="Arc" Click="OnInsertShape"/>
                                <Button Content="贝塞尔" Tag="Bezier" Click="OnInsertShape"/>
                                <Button Content="自由路径" Tag="Path" Click="OnInsertShape"/>
                                <Button Content="文字图元" Tag="Text" Click="OnInsertShape"/>
                                <Button Content="按钮控件" Tag="WidgetButton" Click="OnInsertShape"/>
                                <Button Content="图片/SVG资源" Click="OnInsertVisualAsset"/>
                                <Button Content="文本框控件" Tag="core.widget.textbox" Click="OnInsertShape"/>
                                <Button Content="勾选控件" Tag="core.widget.checkbox" Click="OnInsertShape"/>
                                <Button Content="滑块控件" Tag="core.widget.slider" Click="OnInsertShape"/>
                                <Button Content="进度控件" Tag="core.widget.progressbar" Click="OnInsertShape"/>
                                <Button Content="下拉控件" Tag="core.widget.combobox" Click="OnInsertShape"/>
                                <Button Content="左对齐" Tag="left" Click="OnAlignVisuals"/>
