<Window x:Class="CxVisual.TestCenter.UI.TCTMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CxVisual · Test Center | Foundation / Mechanism"
        Width="1480" Height="890" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="#EAF0F7">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="215"/><RowDefinition Height="32"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#17365D" Padding="14,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="CxVisual · Test Center" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="Foundation / Mechanism · 真实代码测试 · TCT" Foreground="#D1E4F6" FontSize="12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="RunAllButton" Click="OnRunAll" Content="▶ 运行全部"/>
          <Button x:Name="RunSelectedButton" Click="OnRunSelected" Content="▶ 运行选中"/>
          <Button x:Name="CancelButton" Click="OnCancel" Content="■ 取消" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/><ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#CED9E8" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#DCECF9" Padding="12,10">
            <TextBlock Text="测试资源 / 能力树" FontWeight="SemiBold" Foreground="#16395F"/>
          </Border>
          <TreeView x:Name="TestTree" BorderThickness="0" Margin="6" SelectedItemChanged="OnTestSelected"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Background="#D7E2ED" Width="5" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="2" Background="White" BorderBrush="#CED9E8" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#DCECF9" Padding="12,9">
            <TextBlock Text="测试文档 / 观察视图" FontWeight="SemiBold" Foreground="#16395F"/>
          </Border>
          <TabControl Margin="5">
            <TabItem Header="输入 / 观察">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="PreviewText" Margin="16" TextWrapping="Wrap" FontSize="14"
                           Foreground="#263648" LineHeight="26"
                           Text="选择左侧用例并运行。观察内容由测试执行产生，不预填成功状态。"/>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="断言">
              <DataGrid x:Name="AssertionGrid" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserAddRows="False" HeadersVisibility="Column" Margin="3">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="断言" Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/>
                  <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="*"/>
                  <DataGridCheckBoxColumn Header="通过" Binding="{Binding Passed}" Width="75"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="失败 / 诊断">
              <ScrollViewer><TextBlock x:Name="ErrorText" Margin="16" TextWrapping="Wrap" FontFamily="Consolas"
                                       Text="运行后显示真实异常及失败断言。"/></ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="3" Background="#D7E2ED" Width="5" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="4" Background="White" BorderBrush="#CED9E8" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#DCECF9" Padding="12,10">
            <TextBlock Text="Test Inspector" FontWeight="SemiBold" Foreground="#16395F"/>
          </Border>
          <ScrollViewer>
            <TextBlock x:Name="InspectorText" Margin="14" FontSize="13" LineHeight="24" TextWrapping="Wrap"
                       Text="测试对象、能力ID、运行状态和断言摘要将在这里显示。"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="White" Margin="8,0,8,8" BorderBrush="#CED9E8" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#DCECF9" Padding="12,7">
          <TextBlock Text="测试结果 / Results" FontWeight="SemiBold" Foreground="#16395F"/>
        </Border>
        <DataGrid x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionChanged="OnResultSelected">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Descriptor.Id}" Width="120"/>
            <DataGridTextColumn Header="测试用例" Binding="{Binding Descriptor.Name}" Width="2*"/>
            <DataGridTextColumn Header="方面" Binding="{Binding Descriptor.Aspect}" Width="110"/>
            <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="95"/>
            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding Elapsed.TotalMilliseconds, StringFormat=F2}" Width="100"/>
            <DataGridTextColumn Header="异常摘要" Binding="{Binding Error}" Width="2*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Background="#17365D" Padding="10,6">
      <DockPanel>
        <TextBlock x:Name="StatusText" Foreground="White" Text="Ready · 仅真实代码用例可执行；Graph/Protocol/Runtime尚未接入"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>