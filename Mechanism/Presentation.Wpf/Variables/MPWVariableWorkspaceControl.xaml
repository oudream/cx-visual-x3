<UserControl x:Class="CxVisual.Mechanism.Presentation.Wpf.Variables.MPWVariableWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600" MinHeight="380">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="4,2,4,9" LastChildFill="True">
      <TextBlock Text="变量搜索" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
      <Button x:Name="RefreshButton" Content="刷新" DockPanel.Dock="Right"
              Padding="14,5" Margin="8,0,0,0" Click="RefreshClicked"/>
      <TextBox x:Name="SearchBox" MinWidth="160" VerticalContentAlignment="Center"
               ToolTip="按名称或稳定VariableId过滤" TextChanged="SearchChanged"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Header="运行变量组织树" Grid.Column="0" Margin="2">
        <TreeView x:Name="VariableTree" SelectedItemChanged="VariableSelected"/>
      </GroupBox>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="#9099A7"/>
      <TabControl Grid.Column="2" Margin="2">
        <TabItem Header="实时监视">
          <DataGrid x:Name="WatchGrid" AutoGenerateColumns="True" IsReadOnly="True"
                    CanUserAddRows="False" EnableRowVirtualization="True"
                    HeadersVisibility="Column"/>
        </TabItem>
        <TabItem Header="变化记录">
          <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="True" IsReadOnly="True"
                    CanUserAddRows="False" EnableRowVirtualization="True"/>
        </TabItem>
        <TabItem Header="Provider / Mapping">
          <DataGrid x:Name="ProvidersGrid" AutoGenerateColumns="True" IsReadOnly="True"
                    CanUserAddRows="False" EnableRowVirtualization="True"/>
        </TabItem>
        <TabItem Header="运行值操作">
          <StackPanel Margin="14">
            <TextBlock Text="仅可信运行宿主显式授权后可写，修改运行值不等于设备命令执行。"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="SelectionLabel" Text="请选择变量" Margin="0,0,0,7"/>
            <TextBox x:Name="ValueInput" MinWidth="140" Margin="0,0,0,10"/>
            <Button x:Name="WriteButton" Content="写入当前变量" Padding="12,7"
                    HorizontalAlignment="Left" IsEnabled="False" Click="WriteClicked"/>
            <TextBlock x:Name="WriteStatus" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"
               Margin="5,8,3,2" Foreground="#60718A" FontSize="12"/>
  </Grid>
</UserControl>