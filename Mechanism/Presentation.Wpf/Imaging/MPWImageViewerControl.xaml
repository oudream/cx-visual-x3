<UserControl x:Class="CxVisual.Mechanism.Presentation.Wpf.Imaging.MPWImageViewerControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:imaging="clr-namespace:CxVisual.Mechanism.Presentation.Wpf.Imaging"
 MinWidth="220" MinHeight="160" SnapsToDevicePixels="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Row="0" Grid.Column="1">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition x:Name="ComparisonRulerDivider" Width="0"/>
     <ColumnDefinition x:Name="ComparisonRulerColumn" Width="0"/>
    </Grid.ColumnDefinitions>
    <imaging:MPWImageRulerControl x:Name="HorizontalRuler" Grid.Column="0" Orientation="Horizontal"/>
    <imaging:MPWImageRulerControl x:Name="SecondaryHorizontalRuler" Grid.Column="2"
      Orientation="Horizontal" Visibility="Collapsed"/>
   </Grid>
   <imaging:MPWImageRulerControl x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0" Orientation="Vertical"/>
  <Grid x:Name="ComparisonLayout" Grid.Row="1" Grid.Column="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition x:Name="ComparisonDividerColumn" Width="0"/>
    <ColumnDefinition x:Name="SecondaryColumn" Width="0"/>
   </Grid.ColumnDefinitions>
  <Grid x:Name="ViewportRoot" Grid.Column="0" ClipToBounds="True" Background="#1D2430"
   MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp" MouseMove="OnMouseMove"
   MouseWheel="OnMouseWheel" MouseLeave="OnMouseLeave" SizeChanged="OnViewportSizeChanged">
   <Image x:Name="PixelImage" Stretch="None" HorizontalAlignment="Left"
     VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"
     SnapsToDevicePixels="True" IsHitTestVisible="False">
    <Image.RenderTransform><MatrixTransform x:Name="ImageTransform"/></Image.RenderTransform>
   </Image>
   <TextBlock x:Name="OriginalPaneLabel" Text="原图" Foreground="#E6F1FD" Background="#99162231"
      HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,3" Margin="5"
      Visibility="Collapsed" IsHitTestVisible="False"/>
   <Canvas x:Name="SelectionLayer" IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
    <Polyline x:Name="DraftPolyline" Stroke="#FFFFD157" StrokeThickness="1.5"
        StrokeDashArray="4,3" Visibility="Collapsed" Fill="Transparent" IsHitTestVisible="False"/>
    <Rectangle x:Name="SelectedRoi" Stroke="#FFD157" StrokeThickness="1.5"
       Fill="#30FFD157" Visibility="Collapsed"/>
   </Canvas>
   <TextBlock x:Name="EmptyText" Text="打开图像，或从开发者 API 设置 FIMImageBuffer"
      Foreground="#AAB7C8" FontSize="14" HorizontalAlignment="Center"
      VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
    Background="#6B839F" Visibility="Collapsed" x:Name="ComparisonDivider"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
   <Grid x:Name="SecondaryViewportRoot" Grid.Column="2" Background="#1D2430"
    ClipToBounds="True" Visibility="Collapsed"
    MouseLeftButtonDown="OnSecondaryMouseDown" MouseLeftButtonUp="OnSecondaryMouseUp"
    MouseMove="OnSecondaryMouseMove" MouseWheel="OnSecondaryMouseWheel"
    SizeChanged="OnSecondaryViewportSizeChanged">
    <Image x:Name="SecondaryPixelImage" Stretch="None" HorizontalAlignment="Left"
     VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"
     SnapsToDevicePixels="True" IsHitTestVisible="False">
     <Image.RenderTransform><MatrixTransform x:Name="SecondaryImageTransform"/></Image.RenderTransform>
    </Image>
    <Canvas x:Name="SecondaryOverlayCanvas" IsHitTestVisible="False"/>
    <TextBlock Text="结果图" Foreground="#E6F1FD" Background="#99162231"
     HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,3"
     Margin="5" IsHitTestVisible="False"/>
   </Grid>
  </Grid>
  </Grid>
  <Border Grid.Row="1" Background="#F1F5FB" BorderBrush="#CAD5E5"
     BorderThickness="0,1,0,0" Padding="8,3">
   <TextBlock x:Name="PixelStatus" Text="未载入图像" Foreground="#3B526D"
     VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</UserControl>
