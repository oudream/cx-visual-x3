<Application x:Class="CxVisual.TestCenter.UI.TCTApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CxVisual.Mechanism.Presentation.Wpf;component/Themes/MPWVisualPalette.xaml"/>
        <ResourceDictionary Source="/CxVisual.Mechanism.Presentation.Wpf;component/Themes/MPWWorkspaceControls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- 仅保留TestCenter历史Key/字体默认；控件外观由Presentation.Wpf统一。 -->
      <SolidColorBrush x:Key="TCTPrimary" Color="#17365D"/>
      <SolidColorBrush x:Key="TCTAccent" Color="#2477BE"/>
      <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MPWBodyTextStyle}"/>
      <Style TargetType="{x:Type TreeView}" BasedOn="{StaticResource MPWTreeStyle}"/>
      <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource MPWTreeItemStyle}"/>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MPWInputStyle}"/>
      <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MPWComboStyle}"/>
      <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MPWDataGridStyle}"/>
      <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MPWButtonStyle}">
        <Setter Property="MinWidth" Value="78"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>