<Window x:Class="CxVisual.TestCenter.UI.TCTMainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:CxVisual.TestCenter.UI"
 xmlns:dock="https://github.com/Dirkster99/AvalonDock"
 Title="CxVisual · TestCenter — 统一测试与质量工作台"
 Width="1600" Height="960" MinWidth="1100" MinHeight="700"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
 Background="#EEF3F9">
 <Window.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="BorderBrush" Value="#C4D3E4"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Padding" Value="3"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="44"/>
   <RowDefinition Height="31"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="33"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#17365D" Padding="13,8">
   <DockPanel>
    <TextBlock Text="Cx" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,12,0"/>
    <TextBlock Text="CxVisual · TestCenter   |   Foundation · Mechanism · Professional"
     Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <Menu Grid.Row="1" Background="#F4F7FC" Padding="7,0">
   <MenuItem Header="文件">
    <MenuItem x:Name="MenuSaveHistory" Header="归档当前Run"/>
    <MenuItem x:Name="MenuLoadHistory" Header="查看历史面板"/>
    <Separator/>
    <MenuItem x:Name="MenuExportReport" Header="导出报告"/>
   </MenuItem>
   <MenuItem Header="测试">
    <MenuItem x:Name="MenuRunSelected" Header="运行选中"/>
    <MenuItem x:Name="MenuRunAll" Header="运行全部"/>
    <MenuItem x:Name="MenuRerunFailed" Header="重跑失败"/>
    <MenuItem x:Name="MenuCancel" Header="取消"/>
   </MenuItem>
   <MenuItem Header="视图">
    <MenuItem x:Name="MenuRestoreLayout" Header="恢复默认布局"/>
    <MenuItem x:Name="MenuSaveLayout" Header="保存当前布局"/>
    <Separator/>
    <MenuItem x:Name="MenuThemeLight" Header="浅色主题"/>
    <MenuItem x:Name="MenuThemeDark" Header="深色主题"/>
   </MenuItem>
  </Menu>
  <ToolBarTray x:Name="RibbonTray" Grid.Row="2" Background="#E0EDF9"/>
  <dock:DockingManager x:Name="TestDock" Grid.Row="3">
   <dock:LayoutRoot>
    <dock:LayoutPanel Orientation="Vertical">
     <dock:LayoutPanel Orientation="Horizontal">
      <dock:LayoutAnchorablePane DockWidth="290">
       <dock:LayoutAnchorable ContentId="test.explorer" Title="Explorer · 能力与用例"
         CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
        <ui:TCTTestExplorerControl x:Name="Explorer"/>
       </dock:LayoutAnchorable>
      </dock:LayoutAnchorablePane>
      <dock:LayoutDocumentPane>
       <dock:LayoutDocument ContentId="test.documents" Title="DocumentHost · 专业证据"
         CanClose="False" CanFloat="True">
        <ui:TCTTestDocumentHostControl x:Name="DocumentHost"/>
       </dock:LayoutDocument>
      </dock:LayoutDocumentPane>
      <dock:LayoutAnchorablePane DockWidth="330">
       <dock:LayoutAnchorable ContentId="test.inspector" Title="Inspector · 诊断与对象"
         CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
        <ui:TCTTestInspectorControl x:Name="Inspector"/>
       </dock:LayoutAnchorable>
      </dock:LayoutAnchorablePane>
     </dock:LayoutPanel>
     <dock:LayoutAnchorablePane DockHeight="250">
      <dock:LayoutAnchorable ContentId="test.results" Title="Results · 真实执行"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestResultsControl x:Name="Results"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.timeline" Title="Timeline · Attempt事件"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestTimelineControl x:Name="Timeline"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.history" Title="History · 验证与重跑"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestHistoryControl x:Name="History"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.plan" Title="Suite / Plan · 选择与执行"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestPlanControl x:Name="TestPlan"/>
      </dock:LayoutAnchorable>
     </dock:LayoutAnchorablePane>
    </dock:LayoutPanel>
   </dock:LayoutRoot>
  </dock:DockingManager>
  <Border Grid.Row="4" Background="#17365D" Padding="12,6">
   <TextBlock x:Name="StatusText" Foreground="White" Text="Ready" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>