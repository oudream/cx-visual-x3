<UserControl x:Class="CxVisual.Mechanism.Presentation.Wpf.RuntimeData.MPWDataLifecycleWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="380" MinWidth="680">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="运行时数据 · 五维生命周期"/>
      <TextBlock Margin="0,7,0,16" TextWrapping="Wrap" Foreground="#64748B"
                 Text="只投影可信运行宿主提供的MDS Heap。此页面修改运行策略，不代表已保存到工程，也不表示GPU/SDK等外部资源已安全释放。"/>
      <DockPanel Margin="0,0,0,12">
        <Button x:Name="RefreshButton" Content="刷新数据" DockPanel.Dock="Right"
                Padding="12,6" Click="RefreshClicked"/>
        <ComboBox x:Name="DataItems" MinWidth="200" Margin="0,0,8,0"
                  SelectionChanged="SelectionChanged"/>
      </DockPanel>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="175"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ownership · 所有权" VerticalAlignment="Center"/>
        <ComboBox x:Name="OwnershipMode" Grid.Row="0" Grid.Column="1" Margin="4"/>
        <Button Grid.Row="0" Grid.Column="2" Tag="Ownership" Content="单独应用" Click="ApplyOneClicked" Margin="4"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Lifetime · 可用期" VerticalAlignment="Center"/>
        <ComboBox x:Name="LifetimeMode" Grid.Row="1" Grid.Column="1" Margin="4"/>
        <Button Grid.Row="1" Grid.Column="2" Tag="Lifetime" Content="单独应用" Click="ApplyOneClicked" Margin="4"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Retention · 保留" VerticalAlignment="Center"/>
        <ComboBox x:Name="RetentionMode" Grid.Row="2" Grid.Column="1" Margin="4"/>
        <Button Grid.Row="2" Grid.Column="2" Tag="Retention" Content="单独应用" Click="ApplyOneClicked" Margin="4"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Transfer · 交接" VerticalAlignment="Center"/>
        <ComboBox x:Name="TransferMode" Grid.Row="3" Grid.Column="1" Margin="4"/>
        <Button Grid.Row="3" Grid.Column="2" Tag="Transfer" Content="单独应用" Click="ApplyOneClicked" Margin="4"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Reclamation · 回收" VerticalAlignment="Center"/>
        <ComboBox x:Name="ReclamationMode" Grid.Row="4" Grid.Column="1" Margin="4"/>
        <Button Grid.Row="4" Grid.Column="2" Tag="Reclamation" Content="单独应用" Click="ApplyOneClicked" Margin="4"/>
      </Grid>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ApplyAllButton" Content="组合应用五维策略" Padding="15,7"
                Margin="0,0,8,0" Click="ApplyAllClicked"/>
        <Button Content="刷新诊断" Padding="15,7" Click="RefreshClicked"/>
      </StackPanel>
      <GroupBox Header="工程配置（MHS 版本化 Saved / Effective）" Margin="0,14,0,4">
        <StackPanel Margin="10">
          <TextBlock TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,8"
                     Text="工程配置属于MHS唯一配置Owner：保存只产生Saved修订，不自动发布Effective、不改当前Run。Host须授权保存，审批后才能由新Task读取生效快照。"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="缓存TTL(秒)" VerticalAlignment="Center"/>
            <TextBox x:Name="CacheTtlSecondsBox" Width="80" Margin="8,0,12,0"
                     Text="120" VerticalContentAlignment="Center"/>
            <Button x:Name="LoadEngineeringButton" Content="读取工程Saved"
                    Padding="12,6" Margin="0,0,8,0" Click="LoadEngineeringClicked"/>
            <Button x:Name="SaveEngineeringButton" Content="保存工程草稿"
                    Padding="12,6" Click="SaveEngineeringClicked"/>
          </StackPanel>
          <TextBlock x:Name="EngineeringStatus" TextWrapping="Wrap" Foreground="#64748B"/>
        </StackPanel>
      </GroupBox>
      <TextBlock x:Name="OperationStatus" Margin="0,12,0,6" TextWrapping="Wrap"/>
      <GroupBox Header="真实运行态与回收阻断">
        <TextBlock x:Name="Diagnostics" FontFamily="Consolas" Padding="12"
                   TextWrapping="Wrap" MinHeight="110"/>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>