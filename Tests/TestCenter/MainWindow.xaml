<Window x:Class="CxVisual.TestCenter.UI.TCTMainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:CxVisual.TestCenter.UI"
 xmlns:dock="https://github.com/Dirkster99/AvalonDock"
 Title="CxVisual · TestCenter — 统一测试与质量工作台"
 Width="1800" Height="1020" MinWidth="1180" MinHeight="760"
 WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI"
 FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 Background="#EEF3F9">
 <Window.Resources>
  <Style TargetType="TabItem">
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="BorderBrush" Value="#C4D3E4"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Padding" Value="3"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="45"/>
   <RowDefinition Height="30"/>
   <RowDefinition Height="0"/>
   <RowDefinition Height="0"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="27"/>
  </Grid.RowDefinitions>
  <Border x:Name="HeaderBand" Grid.Row="0" Background="#F2F6FB" Padding="13,8">
   <DockPanel>
    <Border Background="#237CCB" CornerRadius="3" Padding="6,2" Margin="0,0,11,0">
     <TextBlock Text="Cx" Foreground="White" FontSize="18" FontWeight="Bold"/>
    </Border>
    <TextBlock x:Name="ProductNameText" Text="CxVisual 工业可视化组态平台  ·  Platform Test Center"
     Foreground="#244467" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="ProjectLabelText" Text="测试工程：CxVisual.TestCenter  ·  .NET Framework 4.8" DockPanel.Dock="Right"
     Foreground="#6D85A0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="30,0,0,0"/>
   </DockPanel>
  </Border>
  <Menu Grid.Row="1" Background="#F4F7FC" Padding="7,0">
   <MenuItem Header="文件">
    <MenuItem x:Name="MenuSaveHistory" Header="归档当前Run"/>
    <MenuItem x:Name="MenuLoadHistory" Header="查看历史面板"/>
    <Separator/>
    <MenuItem x:Name="MenuExportReport" Header="导出报告"/>
   </MenuItem>
   <MenuItem Header="测试">
    <MenuItem x:Name="MenuRunSelected" Header="运行选中"/>
    <MenuItem x:Name="MenuRunAll" Header="运行全部"/>
    <MenuItem x:Name="MenuRerunFailed" Header="重跑失败"/>
    <MenuItem x:Name="MenuCancel" Header="取消"/>
   </MenuItem>
   <MenuItem Header="视图">
    <MenuItem x:Name="MenuRestoreLayout" Header="恢复默认布局"/>
    <MenuItem x:Name="MenuShowOperations" Header="显示测试控制台"/>
    <MenuItem x:Name="MenuSaveLayout" Header="保存当前布局"/>
    <Separator/>
    <MenuItem x:Name="MenuThemeLight" Header="浅色主题"/>
    <MenuItem x:Name="MenuThemeDark" Header="深色主题"/>
   </MenuItem>
  </Menu>

  <!-- 旧Overview/环境横栏不再占据屏幕高度。保留具名数据节点以兼容既有状态更新和主题切换。 -->
  <Border x:Name="BreadcrumbBand" Grid.Row="3" Visibility="Collapsed" Height="0"
   Background="#F2F6FB" BorderBrush="#C4D8ED" BorderThickness="0,0,0,0">
   <DockPanel Margin="15,0" LastChildFill="True">
    <TextBlock x:Name="EnvironmentText" DockPanel.Dock="Right" Text="环境：本地  ·  SIMULATE  ·  Target: .NET Framework 4.8"
     Foreground="#637D98" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/>
    <TextBlock x:Name="WorkspaceTitle" Text="测试主界面 / Overview"
     Foreground="#17365D" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <dock:DockingManager x:Name="TestDock" Grid.Row="4"
    AnchorableHeaderTemplate="{StaticResource TCTDockTabHeaderTemplate}">
   <dock:LayoutRoot>
    <dock:LayoutPanel Orientation="Vertical">
     <dock:LayoutPanel Orientation="Horizontal">
      <dock:LayoutAnchorablePane DockWidth="260">
       <dock:LayoutAnchorable ContentId="test.explorer" Title="测试资源浏览器 / Explorer"
         CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
        <ui:TCTTestExplorerControl x:Name="Explorer"/>
       </dock:LayoutAnchorable>
      </dock:LayoutAnchorablePane>
      <dock:LayoutDocumentPane ShowHeader="False">
       <dock:LayoutDocument ContentId="test.documents" Title="工作区"
         CanClose="False" CanFloat="True">
        <Grid x:Name="AutomatedWorkbenchFrame" Background="#F9FBFE">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="180"/>
          <ColumnDefinition x:Name="TestConsoleSplitterColumn" Width="0"/>
          <ColumnDefinition x:Name="TestConsoleColumn" Width="0"/>
         </Grid.ColumnDefinitions>
         <ui:TCTTestDocumentHostControl x:Name="DocumentHost" Grid.Column="0"/>
         <GridSplitter x:Name="TestConsoleSplitter" Grid.Column="1" Visibility="Collapsed"
          Background="#D5E2F1" HorizontalAlignment="Stretch"
          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
         <Border x:Name="TestConsolePanel" Grid.Column="2" Visibility="Collapsed"
           Background="White" BorderBrush="#C5D8ED" BorderThickness="1,0,0,0">
          <DockPanel x:Name="OperationDock" Background="White">
           <Border DockPanel.Dock="Top" Background="#EAF3FE" Padding="9,8">
            <DockPanel LastChildFill="True">
             <Button x:Name="HideTestConsoleButton" DockPanel.Dock="Right"
              Content="收起" Padding="8,2" Margin="5,0,0,0" MinWidth="45"
              ToolTip="仅隐藏测试控制台，不停止运行中的测试"/>
             <TextBlock Text="测试控制台 / Test Console" FontSize="16"
              FontWeight="SemiBold" Foreground="#244467" VerticalAlignment="Center"/>
            </DockPanel>
           </Border>
           <ScrollViewer DockPanel.Dock="Top" MaxHeight="255"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="9,8,7,6">
             <StackPanel x:Name="AutoActionHost"/>
             <StackPanel x:Name="ManualActionHost" Visibility="Collapsed"/>
            </StackPanel>
           </ScrollViewer>
           <ui:TCTTestInspectorControl x:Name="Inspector"/>
          </DockPanel>
         </Border>
        </Grid>
       </dock:LayoutDocument>
      </dock:LayoutDocumentPane>

     </dock:LayoutPanel>
     <dock:LayoutAnchorablePane DockHeight="145">
      <dock:LayoutAnchorable ContentId="test.results" Title="测试结果  /  Results"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestResultsControl x:Name="Results"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.timeline" Title="时间线  /  Timeline"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestTimelineControl x:Name="Timeline"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.history" Title="历史记录  /  History"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestHistoryControl x:Name="History"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.diff" Title="证据对比  /  Diff"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestDiffControl x:Name="Diff"/>
      </dock:LayoutAnchorable>
      <dock:LayoutAnchorable ContentId="test.plan" Title="测试计划  /  Suite"
        CanClose="False" CanFloat="True" CanHide="True" CanAutoHide="True">
       <ui:TCTTestPlanControl x:Name="TestPlan"/>
      </dock:LayoutAnchorable>
     </dock:LayoutAnchorablePane>
    </dock:LayoutPanel>
   </dock:LayoutRoot>
  </dock:DockingManager>
  <Border Grid.Row="5" Background="#F2F7FC" BorderBrush="#C1D5E9" BorderThickness="0,1,0,0" Padding="12,5">
   <TextBlock x:Name="StatusText" Foreground="#244871" Text="Ready" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>