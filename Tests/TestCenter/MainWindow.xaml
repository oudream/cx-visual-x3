<Window x:Class="CxVisual.TestCenter.UI.TCTMainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:CxVisual.TestCenter.UI"
 Title="CxVisual · TestCenter — Foundation / Mechanism"
 Width="1550" Height="920" MinWidth="1080" MinHeight="650"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
 Background="#EAF0F7">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="225"/><RowDefinition Height="31"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#17365D" Padding="13,8">
   <DockPanel>
    <TextBlock Text="Cx" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,12,0"/>
    <TextBlock Text="CxVisual · TestCenter — 公共基础与机制测试"
     Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="  |  TCT" Foreground="#BAD8F2" VerticalAlignment="Center" Margin="14,0,0,0"/>
   </DockPanel>
  </Border>
  <ToolBarTray x:Name="RibbonTray" Grid.Row="1" Background="#E0EDF9"/>
  <Grid Grid.Row="2" Margin="7">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="260"/><ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="5"/>
    <ColumnDefinition Width="320"/>
   </Grid.ColumnDefinitions>
   <GroupBox Header="能力 / 测试用例" Grid.Column="0" Background="White">
    <ui:TCTTestExplorerControl x:Name="Explorer"/>
   </GroupBox>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
   <GroupBox Header="Test Document · 专业观察数据" Grid.Column="2" Background="White">
    <ui:TCTTestDocumentHostControl x:Name="DocumentHost"/>
   </GroupBox>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
   <GroupBox Header="属性 / 断言 / 诊断" Grid.Column="4" Background="White">
    <ui:TCTTestInspectorControl x:Name="Inspector"/>
   </GroupBox>
  </Grid>
  <TabControl Grid.Row="3" Margin="7,0,7,7" Background="White">
   <TabItem Header="Results · 真实测试结果">
    <ui:TCTTestResultsControl x:Name="Results"/>
   </TabItem>
   <TabItem Header="Timeline · Worker实时事件">
    <ui:TCTTestTimelineControl x:Name="Timeline"/>
   </TabItem>
  </TabControl>
  <Border Grid.Row="4" Background="#17365D" Padding="10,5">
   <TextBlock x:Name="StatusText" Foreground="White" Text="Ready"/>
  </Border>
 </Grid>
</Window>