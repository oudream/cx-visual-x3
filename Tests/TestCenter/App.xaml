<Application x:Class="CxVisual.TestCenter.UI.TCTApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="TCTPrimary" Color="#17365D" />
    <SolidColorBrush x:Key="TCTAccent" Color="#2477BE" />
    <!-- 显示清晰度基线：较大的正文、整像素布局、原生Display字体栅格化 -->
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="{x:Type TreeView}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="{x:Type TreeViewItem}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="3,3"/>
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="RowHeight" Value="29"/>
      <Setter Property="ColumnHeaderHeight" Value="31"/>
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- 所有中央实例Tab与概览/测试Viewer共用这一套激活、悬停与间距语义。 -->
    <Style x:Key="TCTDocumentTabStyle" TargetType="{x:Type TabItem}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#455F80"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabSurface" Background="#E9F0F8" BorderBrush="#C8D8EA"
              BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}"
              CornerRadius="3,3,0,0" Margin="1,1,2,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                HorizontalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#DAEBFB"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#2385DF"/>
                <Setter TargetName="TabSurface" Property="BorderThickness" Value="1,3,1,0"/>
                <Setter Property="Foreground" Value="#174F8C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- AvalonDock保留原有停靠/浮动/布局序列化，只修改Tab标题视觉。
         Binding来自正式LayoutAnchorable，IsSelected反映当前页。 -->
    <DataTemplate x:Key="TCTDockTabHeaderTemplate">
      <Border x:Name="DockTabSurface" Padding="12,8,12,7" Margin="1,0,1,0"
        CornerRadius="3,3,0,0" Background="#EAF1F8"
        BorderBrush="#D1DFEE" BorderThickness="1,1,1,0">
        <TextBlock Text="{Binding Title}" FontFamily="Microsoft YaHei UI"
          FontSize="13" Foreground="#506D8D" FontWeight="Medium"
          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="DockTabSurface" Property="Background" Value="#FFFFFF"/>
          <Setter TargetName="DockTabSurface" Property="BorderBrush" Value="#2385DF"/>
          <Setter TargetName="DockTabSurface" Property="BorderThickness" Value="1,3,1,0"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Application.Resources>
</Application>