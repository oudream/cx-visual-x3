<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="StudioPrimaryBrush" Color="#182D4B"/>
    <SolidColorBrush x:Key="StudioPanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StudioTextBrush" Color="#243447"/>
    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="#E9EFF7"/>
    <SolidColorBrush x:Key="StudioBorderBrush" Color="#D2DDEA"/>
    <SolidColorBrush x:Key="StudioAccentBrush" Color="#1969C5"/>
    <SolidColorBrush x:Key="StudioMutedTextBrush" Color="#647999"/>
    <SolidColorBrush x:Key="StudioHoverBrush" Color="#E9F3FF"/>
    <SolidColorBrush x:Key="StudioSelectionBrush" Color="#DCEBFF"/>
    <SolidColorBrush x:Key="StudioPrimaryActionBrush" Color="#146FF4"/>
    <SolidColorBrush x:Key="StudioCardTintBrush" Color="#F3F8FF"/>
    <LinearGradientBrush x:Key="StudioHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E8F3FF" Offset="0"/>
        <GradientStop Color="#F9FCFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StudioHeroBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D7EDFF" Offset="0"/>
        <GradientStop Color="#BCDDFC" Offset="0.55"/>
        <GradientStop Color="#EAF5FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StudioHeroTextBrush" Color="#103B7C"/>
    <SolidColorBrush x:Key="StudioHeroSubtextBrush" Color="#315F98"/>
    <SolidColorBrush x:Key="StudioHeroValueBrush" Color="#1264D8"/>
    <SolidColorBrush x:Key="StudioHeroCardBrush" Color="#F3FAFF"/>
    <SolidColorBrush x:Key="StudioHeroBorderBrush" Color="#C8DFFA"/>
</ResourceDictionary>
