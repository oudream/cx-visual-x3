<Window x:Class="CxVisual.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scene="clr-namespace:CxVisual.Mechanism.Presentation.Wpf;assembly=CxVisual.Mechanism.Presentation.Wpf"
        Title="CxVisual Unified — Engineering / Visual Sample" Width="1100" Height="720"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{StaticResource StudioBackgroundBrush}" FontFamily="Segoe UI">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#182D4B" Padding="18,14">
            <StackPanel>
                <TextBlock Text="CxVisual Unified Studio" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="选择页面，复用组件，编辑参数，保存工程；点击选中，拖动移动，Esc取消" Foreground="#AEC7E9" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" Padding="10" BorderBrush="#CFD8E6" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <Button Command="{Binding NewCommand}" Content="新建工程"/>
                <Button Command="{Binding AddCommand}" Content="添加矩形"/>
                <Button Command="{Binding MoveCommand}" Content="右移20"/>
                <Button Command="{Binding UndoCommand}" Content="撤销"/>
                <Button Command="{Binding RedoCommand}" Content="重做"/>
                <Button Command="{Binding SaveCommand}" Content="保存工程"/>
                <Button Command="{Binding LoadCommand}" Content="打开工程"/>
                <Button Command="{Binding AddPageCommand}" Content="添加页面"/>
                <Button Command="{Binding AddContentCommand}" Content="共享内容"/>
                <Button Command="{Binding AddSymbolCommand}" Content="新建组件"/>
                <Button Command="{Binding DeleteCommand}" Content="删除选中"/>
                <Button Command="{Binding ImportCommand}" Content="导入资源包"/>
                <Button Command="{Binding ExportCommand}" Content="导出所选资源"/>
                <Button Command="{Binding GroupCommand}" Content="所选图元成组"/>
                <Button Command="{Binding UngroupCommand}" Content="解散选中或父分组"/>
                <Button Command="{Binding AddAssetCommand}" Content="添加静态资源"/>
                <ComboBox x:Name="ConfigDemoKind" Width="150" SelectedIndex="0" Margin="10,0,4,0"
                          VerticalContentAlignment="Center" ToolTip="选择一种专业配置案例，均使用统一L1配置服务">
                    <ComboBoxItem Content="Studio配置"/>
                    <ComboBoxItem Content="Automation设备"/>
                    <ComboBoxItem Content="Vision检测"/>
                    <ComboBoxItem Content="CT3D重建"/>
                    <ComboBoxItem Content="复杂配置与集合"/>
                </ComboBox>
                <Button Click="OnConfigDemo" Content="配置编辑 V2.4"/>
                <Button Click="OnEmbeddedConfigDemo" Content="嵌入式编辑"/>
                <Button Click="OnAtomicLayerDemo" Content="原子层配置"/>
                <Button Click="OnMultiModelConfigDemo" Content="多模型原子组"/>
                <Button Click="OnIndependentLayerDemo" Content="独立层配置"/>
                <Button Click="OnPublishConfigDemo" Content="发布示例配置 (L4)"/>
                <Button Click="OnRollbackConfigDemo" Content="回滚发布"/>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E7EDF6" BorderThickness="0,1,0,0" BorderBrush="#D2DCE9" Padding="15,9">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#193B63" />
        </Border>
        <Grid Margin="13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <TabControl Grid.Column="0">
                <TabItem Header="视觉设计">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,2,4,6">
                            <WrapPanel>
                                <Button Content="直线" Tag="Line" Click="OnInsertShape"/>
                                <Button Content="矩形Shape" Tag="Rect" Click="OnInsertShape"/>
                                <Button Content="圆形" Tag="Circle" Click="OnInsertShape"/>
                                <Button Content="椭圆" Tag="Ellipse" Click="OnInsertShape"/>
                                <Button Content="折线" Tag="Polyline" Click="OnInsertShape"/>
                                <Button Content="多边形" Tag="Polygon" Click="OnInsertShape"/>
                                <Button Content="圆弧" Tag="Arc" Click="OnInsertShape"/>
                                <Button Content="贝塞尔" Tag="Bezier" Click="OnInsertShape"/>
                                <Button Content="自由路径" Tag="Path" Click="OnInsertShape"/>
                                <Button Content="文字图元" Tag="Text" Click="OnInsertShape"/>
                                <Button Content="按钮控件" Tag="WidgetButton" Click="OnInsertShape"/>
                                <Button Content="图片/SVG资源" Click="OnInsertVisualAsset"/>
                                <Button Content="文本框控件" Tag="core.widget.textbox" Click="OnInsertShape"/>
                                <Button Content="勾选控件" Tag="core.widget.checkbox" Click="OnInsertShape"/>
                                <Button Content="滑块控件" Tag="core.widget.slider" Click="OnInsertShape"/>
                                <Button Content="进度控件" Tag="core.widget.progressbar" Click="OnInsertShape"/>
                                <Button Content="下拉控件" Tag="core.widget.combobox" Click="OnInsertShape"/>
                                <Button Content="路径插点" Tag="split" Click="OnPathOperation"/>
                                <Button Content="路径删点" Tag="delete" Click="OnPathOperation"/>
                                <Button Content="转直线" Tag="line" Click="OnPathOperation"/>
                                <Button Content="转二次" Tag="quadratic" Click="OnPathOperation"/>
                                <Button Content="转三次" Tag="cubic" Click="OnPathOperation"/>
                                <TextBox x:Name="PathCommandIndex" Width="28" Text="1" ToolTip="路径命令索引（从1开始）"/>
                                <Button Content="放大" Tag="in" Click="OnVisualZoom"/>
                                <Button Content="缩小" Tag="out" Click="OnVisualZoom"/>
                                <Button Content="重置视口" Tag="reset" Click="OnVisualZoom"/>
                                <CheckBox x:Name="VisualGridSnap" Content="吸附25" Click="OnToggleVisualSnap" VerticalAlignment="Center" Margin="6,0"/>
                                <Button Content="添加呼吸动画" Click="OnAddBreathingAnimation"/>
                                <Button x:Name="VisualPreviewButton" Content="预览交互" Click="OnToggleVisualPreview"/>
                            </WrapPanel>
                            <TextBlock x:Name="VisualInfo" Text="选择图元后拖动白色锚点/黄色曲线控制点；紫色缩放、橙色旋转；松开提交、Esc取消、支持撤销重做。"
                                Margin="4,3,0,0" FontSize="11" Foreground="#45617C"/>
                        </StackPanel>
                        <Border CornerRadius="8" Background="White" BorderBrush="#D5DEEA" BorderThickness="1" ClipToBounds="True">
                            <scene:SceneView x:Name="SceneHost" Focusable="True"/>
                        </Border>
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="FlowTab" Header="逻辑编排 · 运行观察">
                    <DockPanel Background="White">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel Margin="10,8">
                                <Button Content="创建 X-Ray 逻辑示例" Click="OnCreateLogicDemo"/>
                                <Button Content="创建自由连接示例" Click="OnCreateWiringDemo"/>
                                <TextBox x:Name="FlowCapabilitySearch" Width="100" Text="Vision" Margin="5,0,2,0"/>
                                <Button Content="搜索能力" Click="OnSearchCapabilities"/>
                                <ComboBox x:Name="FlowCapabilityResults" Width="145" DisplayMemberPath="Definition.Name" SelectionChanged="OnCapabilitySelected"/>
                                <TextBox x:Name="FlowActionCapability" Width="100" Text="AI" Margin="5,0,2,0"/>
                                <Button Content="添加能力" Click="OnAddWiringAction"/>
                                <Button x:Name="FlowWireMode" Content="开始连线" Click="OnToggleWiring"/>
                                <Button Content="验证工程编排" Click="OnValidateWiring"/>
                                <Button Content="仿真执行并追踪" Click="OnRunLogicDemo"/>
                            </WrapPanel>
                            <WrapPanel Margin="10,0,10,8">
                                <ComboBox x:Name="FlowPortPairs" Width="260" DisplayMemberPath="Label"/>
                                <Button Content="确认端口连线" Click="OnConfirmWiringLink"/>
                                <ComboBox x:Name="FlowExistingLinks" Width="220" DisplayMemberPath="Label"/>
                                <Button Content="删除连接" Click="OnDeleteWiringLink"/>
                                <Button Content="删除节点" Click="OnDeleteWiringBlock"/>
                                <Button Content="撤销编排" Click="OnUndoWiring"/>
                                <Button Content="重做编排" Click="OnRedoWiring"/>
                            </WrapPanel>
                            <WrapPanel Margin="10,0,10,8">
                                <Button Content="全选节点" Click="OnFlowSelectAll"/>
                                <Button Content="复制选区" Click="OnFlowCopy"/>
                                <Button Content="粘贴选区" Click="OnFlowPaste"/>
                                <Button Content="删除逻辑选区" Click="OnFlowDeleteSelection"/>
                                <Button Content="组合选中" Click="OnFlowGroup"/>
                                <Button Content="解除组合" Click="OnFlowUngroup"/>
                                <Button Content="对齐左侧" Tag="Left" Click="OnFlowAlign"/>
                                <Button Content="对齐顶部" Tag="Top" Click="OnFlowAlign"/>
                                <Button Content="水平居中" Tag="HorizontalCenter" Click="OnFlowAlign"/>
                                <Button Content="垂直居中" Tag="VerticalCenter" Click="OnFlowAlign"/>
                                <Button Content="放大画布" Tag="in" Click="OnFlowZoom"/>
                                <Button Content="缩小画布" Tag="out" Click="OnFlowZoom"/>
                                <Button Content="100%" Tag="reset" Click="OnFlowZoom"/>
                                <Button Content="适配画布" Click="OnFlowFit"/>
                                <Button Content="定位选中" Click="OnFlowLocate"/>
                                <Button Content="水平分布" Tag="horizontal" Click="OnFlowDistribute"/>
                                <Button Content="垂直分布" Tag="vertical" Click="OnFlowDistribute"/>
                                <Button Content="自动布局" Click="OnFlowArrange"/>
                            </WrapPanel>
                            <TextBlock x:Name="LogicInfo" Margin="12,0,12,10"
                                Text="使用 Content Logic Aspect 保存编排；从运行轨迹点击定位逻辑块。此处为 CPU 仿真，不连接生产设备。"
                                TextWrapping="Wrap" Foreground="#45617C"/>
                        </StackPanel>
                        <ScrollViewer x:Name="FlowScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="OnFlowWheel"
                                      PreviewMouseDown="OnFlowPanDown" PreviewMouseMove="OnFlowPanMove"
                                      PreviewMouseUp="OnFlowPanUp">
                            <scene:MOLFlowCanvas x:Name="LogicHost" Focusable="True"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="8" Background="White" BorderBrush="#D5DEEA" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="工程与编辑状态" FontWeight="SemiBold" FontSize="17" Foreground="#123660" Margin="0,0,0,15"/>
                    <TextBlock Text="当前页面" FontWeight="SemiBold"/>
                    <ComboBox x:Name="EngineeringPages" ItemsSource="{Binding Pages}" SelectedItem="{Binding ActivePage}" DisplayMemberPath="Name" Margin="0,4,0,8"/>
                    <TextBlock Text="{Binding ContextName}" TextWrapping="Wrap"/>
                    <TextBlock Text="工程资源库" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <ListBox x:Name="EngineeringResources" ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" DisplayMemberPath="Name" MaxHeight="120"/>
                    <WrapPanel><Button Command="{Binding PlaceResourceCommand}" Content="放置实例"/><Button Command="{Binding OpenDefinitionCommand}" Content="编辑共享定义"/><Button Command="{Binding BackCommand}" Content="返回"/></WrapPanel>
                    <TextBlock Text="可视对象（Ctrl多选后分组）" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <ListBox x:Name="EngineeringObjects" ItemsSource="{Binding Items}" DisplayMemberPath="Name" MaxHeight="110" SelectionMode="Extended" SelectionChanged="OnVisualSelectionChanged"/>
                    <TextBlock Text="可视图元属性（本地坐标）" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBlock Text="X" VerticalAlignment="Center"/><TextBox x:Name="VisualXInput" Width="51" Text="0"/>
                        <TextBlock Text="Y" VerticalAlignment="Center"/><TextBox x:Name="VisualYInput" Width="51" Text="0"/>
                        <TextBlock Text="W" VerticalAlignment="Center"/><TextBox x:Name="VisualWidthInput" Width="51" Text="120"/>
                        <TextBlock Text="H" VerticalAlignment="Center"/><TextBox x:Name="VisualHeightInput" Width="51" Text="80"/>
                        <TextBlock Text="角度" VerticalAlignment="Center"/><TextBox x:Name="VisualRotationInput" Width="51" Text="0"/>
                        <Button Content="应用几何属性" Click="OnApplyVisualGeometry"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBox x:Name="VisualLayerInput" Width="88" Text="Default" ToolTip="工程图层名"/>
                        <Button Content="应用图层" Click="OnApplyVisualLayer"/>
                        <Button Content="置于顶层" Click="OnBringVisualFront"/>
                    </WrapPanel>
                    <TextBlock Text="图元外观（ARGB / 线宽）" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBox x:Name="FillColorInput" Width="115" Text="#FF4A90E2" ToolTip="ARGB格式，例如#FF4A90E2"/>
                        <TextBox x:Name="StrokeWidthInput" Width="50" Text="2" ToolTip="描边宽度"/>
                        <Button Content="应用填充" Click="OnApplyVisualStyle"/>
                    </WrapPanel>
                    <TextBlock Text="数据绑定（直接引用已有MDS变量名）" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBox x:Name="VisualBindingPropertyInput" Width="68" Text="visible" ToolTip="visible/x/y/width/height/rotation/value"/>
                        <TextBox x:Name="VisualBindingSourceInput" Width="120" Text="Motor.Ready" ToolTip="MDS变量名"/>
                        <Button Content="绑定变量" Click="OnApplyVisualBinding"/>
                    </WrapPanel>
                    <TextBlock Text="状态样式 / 动画参数" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBox x:Name="VisualStateInput" Width="66" Text="Fault" ToolTip="布尔状态变量名"/>
                        <TextBox x:Name="VisualStateColorInput" Width="91" Text="#FFFF3030" ToolTip="状态填充颜色"/>
                        <Button Content="添加状态" Click="OnAddVisualState"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBox x:Name="VisualAnimationProperty" Width="65" Text="opacity" ToolTip="opacity/x/y/rotation"/>
                        <TextBox x:Name="VisualAnimationFrom" Width="44" Text="0.2"/>
                        <TextBox x:Name="VisualAnimationTo" Width="44" Text="1"/>
                        <TextBox x:Name="VisualAnimationDuration" Width="51" Text="1000" ToolTip="时长ms"/>
                        <Button Content="应用动画" Click="OnApplyVisualAnimation"/>
                    </WrapPanel>
                    <TextBlock Text="完整画面样式" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBox x:Name="VisualStrokeColor" Width="100" Text="#FF184E83" ToolTip="ARGB描边颜色"/>
                        <TextBox x:Name="VisualOpacityInput" Width="50" Text="1" ToolTip="不透明度0~1"/>
                        <TextBox x:Name="VisualFontSizeInput" Width="44" Text="12" ToolTip="文字字号"/>
                        <Button Content="应用完整样式" Click="OnApplyFullStyle"/>
                    </WrapPanel>
                    <TextBlock Text="运行事件定义（执行需专业命令授权）" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <WrapPanel>
                        <TextBox x:Name="EventIdInput" Width="78" Text="Click" ToolTip="事件名称"/>
                        <TextBox x:Name="ActionIdInput" Width="108" Text="hmi.open" ToolTip="命令ID"/>
                        <Button Content="绑定事件" Click="OnBindVisualEvent"/>
                    </WrapPanel>
                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" ToolTip="对象或实例名称"/>
                    <WrapPanel><Button Command="{Binding RenameCommand}" Content="重命名"/><Button Command="{Binding AddParameterCommand}" Content="新增数值参数"/></WrapPanel>
                    <WrapPanel><Button Command="{Binding AddInputPortCommand}" Content="新增数值输入"/><Button Command="{Binding AddOutputPortCommand}" Content="新增数值输出"/></WrapPanel>
                    <TextBlock Text="连接来源 → 目标端口" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SourcePort}" DisplayMemberPath="Name"/>
                    <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding TargetPort}" DisplayMemberPath="Name"/>
                    <Button Command="{Binding ConnectPortsCommand}" Content="连接端口"/>
                    <ListBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}" DisplayMemberPath="Name" MaxHeight="80"/>
                    <Button Command="{Binding DisconnectCommand}" Content="断开选中连接"/>
                    <TextBlock Text="所选对象属性 / 实例公开参数" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <ComboBox ItemsSource="{Binding Resources}" SelectedItem="{Binding BindingResource}" DisplayMemberPath="Name" ToolTip="资源来源选择；无需输入内部ID"/>
                    <ItemsControl x:Name="EngineeringProperties" ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,4"><TextBlock Text="{Binding Member}" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding DataContext.BindingModes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Mode}"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                <DockPanel><TextBlock Text="{Binding Source}" VerticalAlignment="Center"/><Button Content="应用" Command="{Binding DataContext.ApplyPropertyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DockPanel>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Project / Page / Content" Foreground="#64748B" FontSize="11" />
                    <TextBlock Text="Symbol / Group / Element" Foreground="#64748B" FontSize="11" Margin="0,0,0,18"/>
                    <TextBlock Text="版本（Revision）" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Revision}" Margin="0,4,0,15" FontSize="20" Foreground="#1D5DA8"/>
                    <TextBlock Text="图元数量" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ElementCount}" Margin="0,4,0,15" FontSize="20" Foreground="#1D5DA8"/>
                    <TextBlock Text="选中节点" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedName}" TextWrapping="Wrap" Margin="0,5,0,15" Foreground="#1D5DA8"/>
                    <Separator Margin="0,0,0,14"/>
                    <TextBlock Text="本版验收路径" FontWeight="SemiBold"/>
                    <TextBlock Text="① 添加图元 → Core原子提交&#10;② 拖动/右移 → Revision递增&#10;③ Undo/Redo → 逆变更提交&#10;④ 保存/加载 → 工程树持久化" TextWrapping="Wrap" FontSize="12" LineHeight="24" Margin="0,8,0,0"/>
                    <TextBlock Text="注：这是架构样例，不包含专业运动控制、工业检测或设备驱动。" TextWrapping="Wrap" Foreground="#B45309" Margin="0,25,0,0" FontSize="12"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
